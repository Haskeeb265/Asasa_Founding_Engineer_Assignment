# Neon pooled Postgres connection string (required)
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional Upstash Redis REST. Unset = process-local memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Source B fetch mode: python | remote | disabled
# Unset is inferred: remote when VERCEL is set, otherwise disabled.
GOLDPRICE_FETCH_MODE=

# Local Python interpreter for scripts/fetch_goldprice.py
PYTHON_BIN=python

# Only needed for remote mode when no Vercel URL variable exists
GOLDPRICE_REMOTE_URL=

# Source C symbol (default GC=F)
YAHOO_SYMBOL=GC=F
