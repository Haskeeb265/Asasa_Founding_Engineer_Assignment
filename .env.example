# --- copy this file to .env and fill in real values ---

# Neon Postgres — use the POOLED connection string (pgbouncer).
DATABASE_URL=

# Upstash Redis (optional: the price cache/cooldown no-op safely when
# these are unset, but set them in production so parallel fetches across
# serverless instances are still claimed once). Names read by
# server/pricing/redis.ts:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# How the GoldPrice.org leg (source B) reaches its TLS-fingerprint WAF:
#   "python"  — local dev: spawns scripts/fetch_goldprice.py (curl_cffi).
#   "remote"  — Vercel: GET the deployed Python function api/goldprice.py
#               (curl_cffi on the Python runtime; the Node image has no Python
#               and plain Node fetch is 403'd by the WAF).
#   "disabled" — skip B entirely (tests).
# Unset, the mode is inferred: "remote" on Vercel, "disabled" anywhere else.
GOLDPRICE_FETCH_MODE=python
PYTHON_BIN=python
# Only needed with "remote" if VERCEL_URL is not injected (e.g. calling a
# separate deployment): full URL of the goldprice function.
GOLDPRICE_REMOTE_URL=

# COMEX front-month contract used as the third source (validator only).
YAHOO_SYMBOL=GC=F
